// Connection URLs live in prisma.config.ts (CLI) and src/db.ts (runtime).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  STAFF
  PARENT
}

enum AccountStatus {
  INACTIVE
  ACTIVE
  PENDING //Submitted application and awaiting admin approval
}

enum StaffRole {
  STAFF
  ADMIN
  SUPER_ADMIN
}

model Account {
  id                Int           @id @default(autoincrement())
  type              AccountType
  email             String        @unique
  passwordHash      String
  status            AccountStatus @default(PENDING)
  // Sessions issued before this are rejected.
  passwordChangedAt DateTime?
  // Deactivation is permanent. The real email moves here so it can be used for a new account.
  deactivatedEmail  String?
  deactivatedAt     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Exactly one, matching type.
  parentProfile ParentProfile?
  staffProfile  StaffProfile?

  passwordResetTokens PasswordResetToken[]

  @@map("accounts")
}

model ParentProfile {
  id        Int      @id @default(autoincrement())
  accountId Int      @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String? // 10 digits, no formatting
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  students StudentParentLink[]

  @@map("parent_profiles")
}

// Emergency contacts and pickup people. They don't have logins.
model Contact {
  id               Int           @id @default(autoincrement())
  parentProfileId  Int
  parentProfile    ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  relationship     String
  phone            String // 10 digits, no formatting
  authorizedPickup Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([parentProfileId])
  @@map("contacts")
}

model StaffProfile {
  id        Int       @id @default(autoincrement())
  accountId Int       @unique
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  role      StaffRole @default(STAFF)
  site      String?
  team      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("staff_profiles")
}

// Only a hash of each token is stored.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  accountId Int
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, createdAt])
  @@map("password_reset_tokens")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model Student {
  id             Int           @id @default(autoincrement())
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  gender         String?
  school         String?
  grade          String?
  program        String
  site           String
  enrollmentDate DateTime
  status         StudentStatus @default(ACTIVE)

  guardianName  String
  guardianPhone String // 10 digits, no formatting
  guardianEmail String

  emergencyContactName         String?
  emergencyContactPhone        String? // 10 digits, no formatting
  emergencyContactRelationship String?

  medicalNotes String? // staff only, never shown to parents

  // Deleting archives instead; archived students are hidden everywhere until a super admin restores them.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  parents StudentParentLink[]

  @@map("students")
}

// Linking approves the parent account to view this student's data.
model StudentParentLink {
  id              Int           @id @default(autoincrement())
  studentId       Int
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentAccountId Int
  parentProfile   ParentProfile @relation(fields: [parentAccountId], references: [accountId], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([studentId, parentAccountId])
  @@index([parentAccountId])
  @@map("student_parent_links")
}

model FormTemplate {
  id Int @id @default(autoincrement())
  title String
  description String
  createdAt DateTime @default(now())
  editedAt DateTime @updatedAt
  
  @@map("form_templates")
}