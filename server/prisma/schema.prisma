// Connection URLs live in prisma.config.ts (CLI) and src/db.ts (runtime).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  STAFF
  PARENT
}

enum AccountStatus {
  INACTIVE
  ACTIVE
  PENDING //Submitted application and awaiting admin approval
}

model Account {
  id           Int           @id @default(autoincrement())
  type         AccountType
  email        String        @unique
  passwordHash String
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("accounts")
}
